# Install only on the private inference service. No world/auth/database/admin keys.
NODE_ENV=production
HOST=0.0.0.0
PORT=4100
INFERENCE_DATA_ROOT=/var/lib/elsewhere-inference
INFERENCE_BROKER_TOKEN=generate-a-new-private-service-secret-at-least-32-characters
HUBERT_OWNER_USER_ID=the-exact-hosted-elsewhere-account-user-id
CHATGPT_PROFILE=default
MODEL_NAME=gpt-6-luna
MODEL_MAX_CALLS_PER_DAY=20
MODEL_TIMEOUT_MS=30000
# Credentials arrive through the private SSH import command, never environment variables.
