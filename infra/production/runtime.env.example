# Template only. Enter real values in the backend host's private environment settings.
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
WEB_ORIGIN=https://your-public-domain.example
DATABASE_URL=postgres://operator-supplied-private-connection
ADMIN_TOKEN=generate-a-separate-random-secret-of-at-least-32-characters
BETTER_AUTH_SECRET=generate-a-separate-random-secret-of-at-least-32-characters
API_PROXY_SECRET=generate-a-separate-random-secret-and-copy-only-this-to-vercel
MODEL_PROVIDER=local
ALLOW_NEW_LIFE=false
SIMULATION_RATE=1
# Optional account verification. Separate from all creature mail credentials.
# AUTH_EMAIL_API_KEY=re_your_dedicated_account_mail_key
# AUTH_EMAIL_FROM=accounts@your-verified-sender-domain.example
# Optional compatible model. Configure its provider-side spending limit too.
# MODEL_PROVIDER=compatible
# MODEL_BASE_URL=https://your-model-provider.example/v1
# MODEL_NAME=your-model
# MODEL_API_KEY=your-server-side-key
# MODEL_MAX_CALLS_PER_DAY=20
# Optional workload routing; never paste actual keys inside the JSON.
# MODEL_PROVIDER=routed
# MODEL_ROUTING_JSON=your-reviewed-compact-JSON-config
# MODEL_CF_INFERENCE_KEY=your-scoped-inference-credential
# MODEL_VERCEL_GATEWAY_KEY=your-separate-budgeted-gateway-credential
