# Copy to .env.vps.local, mode 600, on the VPS. Never add OAuth tokens here.
INFERENCE_BROKER_TOKEN=generate-a-new-random-service-secret-at-least-32-characters
# Leave unbound until the human owner has an Elsewhere account. Inference stays disabled.
# HUBERT_OWNER_USER_ID=the-exact-hosted-elsewhere-account-user-id
CHATGPT_PROFILE=default
MODEL_NAME=gpt-6-luna
MODEL_MAX_CALLS_PER_DAY=20
MODEL_TIMEOUT_MS=30000
# Additional admission safeguards; these do not impose a hard provider-generation/currency cap.
MODEL_MAX_INPUT_TOKENS_PER_DAY=3500000
MODEL_MAX_OUTPUT_TOKENS_PER_DAY=100000
MODEL_MAX_INPUT_TOKENS_PER_REQUEST=32000
MODEL_OUTPUT_TOKEN_RESERVE=2000
MODEL_MAX_UNKNOWN_USAGE_CALLS_PER_DAY=3
MODEL_REQUEST_BODY_TIMEOUT_MS=5000
