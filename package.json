{
  "name": "elsewhere-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ollama": "node scripts/ollama-dev.mjs",
    "dev:configured": "tsx scripts/dev-configured.ts",
    "setup": "tsx scripts/setup.ts",
    "chatgpt": "tsx scripts/chatgpt.ts",
    "dev:chatgpt": "tsx scripts/dev-chatgpt.ts",
    "dev:server": "tsx watch app/main.ts",
    "dev:web": "pnpm --filter @elsewhere/web dev",
    "build": "pnpm --filter @elsewhere/web build",
    "build:server": "pnpm build:world && pnpm build:inference && pnpm build:operator && pnpm build:research",
    "start:production": "node dist/server.mjs",
    "snapshot": "tsx scripts/snapshot.ts",
    "smoke:deployment": "node scripts/deployment-smoke.mjs",
    "smoke:proxy": "node scripts/proxy-security-smoke.mjs",
    "audit:public": "node scripts/public-audit.mjs",
    "start": "tsx app/main.ts",
    "owner": "node scripts/owner.mjs",
    "auth:admin": "tsx scripts/auth-admin.ts",
    "auth:operator": "tsx scripts/auth-operator.ts",
    "ollama:check": "tsx scripts/ollama-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "tsx scripts/smoke.ts",
    "build:world": "esbuild app/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --external:pg --external:better-sqlite3 --external:better-auth --external:better-auth/* --external:dotenv/config --external:zod",
    "build:inference": "esbuild app/inference-main.ts --bundle --platform=node --format=esm --target=node22 --external:pg --external:better-sqlite3 --external:better-auth --external:better-auth/* --external:dotenv/config --external:zod --outfile=dist/inference.mjs && esbuild scripts/inference-operator.ts --bundle --platform=node --format=esm --target=node22 --external:pg --external:better-sqlite3 --external:better-auth --external:better-auth/* --external:dotenv/config --external:zod --outfile=dist/inference-operator.mjs",
    "build:operator": "esbuild scripts/auth-operator.ts --bundle --platform=node --format=esm --target=node22 --external:pg --external:better-sqlite3 --external:better-auth --external:better-auth/* --external:zod --outfile=dist/auth-operator.mjs",
    "start:inference": "node dist/inference.mjs",
    "dev:inference": "tsx app/inference-main.ts",
    "build:research": "esbuild app/research-main.ts --bundle --platform=node --format=esm --target=node22 --external:pg --external:linkedom --external:ipaddr.js --outfile=dist/research.mjs",
    "start:research": "node dist/research.mjs"
  },
  "dependencies": {
    "@elsewhere/character-interfaces": "workspace:*",
    "@elsewhere/character-runtime": "workspace:*",
    "@elsewhere/hubert": "workspace:*",
    "@elsewhere/server": "workspace:*",
    "better-auth": "^1.7.18",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.6.1",
    "ipaddr.js": "2.5.0",
    "jose": "^6.2.15",
    "linkedom": "0.18.15",
    "pg": "^8.16.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "esbuild": "0.25.12",
    "meshoptimizer": "^1.3.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  }
}
