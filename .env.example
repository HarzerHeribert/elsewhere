# No secrets are required for the default local simulation.
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
DATA_DIR=.data
TICK_INTERVAL_MS=2000
# One real second advances three simulated seconds in the local demonstration.
SIMULATION_RATE=3
# Keep credentials out of VITE_* variables: those are public browser code.
# ADMIN_TOKEN=optional-long-random-owner-token-at-least-32-characters

# Default persistence uses Node's built-in SQLite, with no Docker required.
# Set this only to opt into PostgreSQL (for example the local Docker profile).
# DATABASE_URL=postgres://elsewhere:local-development-only@127.0.0.1:5432/elsewhere

# Optional real model. Local mode never makes external model requests.
MODEL_PROVIDER=local
# MODEL_PROVIDER=compatible
# MODEL_BASE_URL=https://your-provider.example/v1
# MODEL_NAME=your-model-name
# MODEL_API_KEY=your-server-side-key
MODEL_MAX_CALLS_PER_DAY=100
MODEL_TIMEOUT_MS=15000

# Optional host-owned multi-model routing (credentials remain separate MODEL_* variables).
# MODEL_PROVIDER=routed
# MODEL_ROUTING_JSON=compact-JSON-from-your-reviewed-model-routing-config
# See infra/production/model-routing.example.json and docs/architecture/deployment.md.
# Quotes in that example are illustrative; enter evaluated models and current conservative rates.

# Local Ollama profile (no API key; uses the local daemon only):
# MODEL_PROVIDER=ollama
# MODEL_NAME=qwen3:4b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Better Auth uses a separately generated local secret and auth.sqlite by default.
# For deployment, use an explicit long random secret and an HTTPS public origin.
# BETTER_AUTH_URL=https://elsewhere.example
# BETTER_AUTH_SECRET=your-generated-secret-at-least-32-characters
# AUTH_DATABASE_URL=postgres://...
# AUTH_ADMIN_USER_IDS=explicit-user-id-from-your-own-account

# Hosted profile: see docs/architecture/deployment.md and infra/production/runtime.env.example.
# Production requires PostgreSQL plus explicit ADMIN_TOKEN, BETTER_AUTH_SECRET and API_PROXY_SECRET.
# API_PROXY_SECRET is also set privately on Vercel; never use a VITE_* variable.
# Optional real account verification, separate from creature mail (no mail sent unless configured):
# AUTH_EMAIL_API_KEY=re_dedicated_account_verification_key
# AUTH_EMAIL_FROM=accounts@your-verified-domain.example
